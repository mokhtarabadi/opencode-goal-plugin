{
  "name": "opencode-goal-plugin",
  "version": "0.2.0",
  "description": "Slash goal with file state for OpenCode V2 Phase 1",
  "license": "MIT",
  "type": "module",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["src", "commands", "README.md", "LICENSE", "CHANGELOG.md", "opencode.json"],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "compile": "tsup src/index.ts --format esm --dts --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-color",
    "format": "prettier --check src tests",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.28"
  }
}
